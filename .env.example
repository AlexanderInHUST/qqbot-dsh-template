# 复制为 .env 后填写。.env 已在 .gitignore 里，不要提交。
#
# 其他需要填的地方不在这里：
#   - QQ 登录：启动后打开 http://127.0.0.1:6081 扫码（见 README「QQ 登录」）
#   - OneBot accessToken、主人 QQ、群白名单、联网搜索的 Key（webSearch.apiKey）：config/qq-bridge/config.json

# SnowLuma 扫码桌面 noVNC 的密码（http://127.0.0.1:6081）。官方镜像不支持关掉密码，
# 用 README 里那个带 password 参数的链接打开就不用手输了
SNOWLUMA_VNC_PASSWD=

# DeepSeek 官方 API 的 Key（必填）：dsh 的模型（config/dsh/home.cordis.patch.yml 的 deepseek-official），
# 以及 extras 的记忆整理、头像描述。联网搜索读不到环境变量，要在 config.json 的 webSearch.apiKey 里再填一次
DEEPSEEK_API_KEY=

# 模型中转站 aiohub 的 Key（可选）：记忆整理（config/extras.json 的 llm）和会话压缩（preset 的 summarizationProvider）默认用它，
# 不填就换回 DeepSeek；把 config.json 的 dsh 段切到 aiohub / aiohub-claude / aiohub-gemini 时也要它
AIOHUB_API_KEY=

# Cloudflare Workers AI 的 API 令牌（可选，要有 Workers AI 权限、账号开了 Workers Paid）：dsh 段切到 cloudflare 时才用
CLOUDFLARE_API_TOKEN=
